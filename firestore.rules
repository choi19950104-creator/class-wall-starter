rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 컬렉션 이름에 공백이 있어 변수로 받아 정확한 이름인지 확인합니다.
    match /{collectionName}/{memoId} {
      allow read: if collectionName == "chating box";

      // 로그인한 사용자는 5글자 이상의 메모만 저장할 수 있습니다.
      allow create: if collectionName == "chating box"
                    && request.auth != null
                    && request.resource.data.keys().hasOnly(["text", "createdAt", "uid"])
                    && request.resource.data.text is string
                    && request.resource.data.text.size() >= 5
                    && request.resource.data.createdAt is int
                    && request.resource.data.uid == request.auth.uid;

      // 자신이 쓴 메모만 지울 수 있습니다.
      allow delete: if collectionName == "chating box"
                    && request.auth != null
                    && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
  }
}
