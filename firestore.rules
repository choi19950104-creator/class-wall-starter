rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function hasRole(expectedRole) {
      return isSignedIn()
             && exists(/databases/$(database)/documents/users/$(request.auth.uid))
             && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == expectedRole;
    }

    function isTeacher() {
      return hasRole("teacher");
    }

    function isStudent() {
      return hasRole("student");
    }

    function isValidMemo() {
      return request.resource.data.keys().hasOnly(["text", "createdAt", "uid", "aiComment", "aiCommentedAt"])
             && request.resource.data.text is string
             && request.resource.data.text.size() >= 5
             && request.resource.data.createdAt is int
             && request.resource.data.uid is string
             && (!("aiComment" in request.resource.data)
                 || (request.resource.data.aiComment is string
                     && request.resource.data.aiComment.size() > 0
                     && request.resource.data.aiComment.size() <= 500))
             && (!("aiCommentedAt" in request.resource.data)
                 || request.resource.data.aiCommentedAt is int);
    }

    // 역할 문서는 users/{uid} 경로에 저장합니다.
    match /users/{userId} {
      allow read: if isTeacher()
                  || (isSignedIn() && request.auth.uid == userId);

      // 처음 로그인한 사용자는 자신의 역할을 student로만 만들 수 있습니다.
      allow create: if isTeacher()
                    || (isSignedIn()
                        && request.auth.uid == userId
                        && request.resource.data.keys().hasOnly(["role"])
                        && request.resource.data.role == "student");

      // 역할 변경과 삭제는 교사만 할 수 있습니다.
      allow update, delete: if isTeacher();
    }

    // 컬렉션 이름에 공백이 있어 변수로 받아 정확한 이름인지 확인합니다.
    match /{collectionName}/{memoId} {
      allow read: if collectionName == "chating box"
                  && (isTeacher() || isStudent());

      // 교사는 모든 권한을 가지며 학생은 자신의 uid로만 메모를 만듭니다.
      allow create: if collectionName == "chating box"
                    && isValidMemo()
                    && (isTeacher()
                        || (isStudent()
                            && request.resource.data.keys().hasOnly(["text", "createdAt", "uid"])
                            && request.resource.data.uid == request.auth.uid));

      // 학생은 자신의 메모 내용과 소유자만 유지하며 수정할 수 있습니다.
      allow update: if collectionName == "chating box"
                    && isValidMemo()
                    && (isTeacher()
                        || (isStudent()
                            && resource.data.uid == request.auth.uid
                            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["text"])
                            && request.resource.data.uid == request.auth.uid));

      // 학생은 자신의 메모만 지울 수 있습니다.
      allow delete: if collectionName == "chating box"
                    && (isTeacher()
                        || (isStudent()
                            && resource.data.uid == request.auth.uid));
    }
  }
}
